<Window x:Class="DiskChecker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskChecker.ViewModels"
        xmlns:conv="clr-namespace:DiskChecker.Converters"
        xmlns:models="clr-namespace:DiskChecker.Models"
        xmlns:views="clr-namespace:DiskChecker.Views"
        Title="{Binding AppTitle}"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgVeryDarkBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" UseAeroCaptionButtons="False" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:SizeToStringConverter x:Key="SizeToString" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
        <conv:MbToDisplayConverter x:Key="MbToDisplay" />
        <conv:BoolToLightRedGreenConverter x:Key="BoolToLightRedGreenConverter" />
        <conv:BoolToDarkRedGreenConverter x:Key="BoolToDarkRedGreenConverter" />
        <conv:EnumToBoolConverter x:Key="FilterTypeConverter" />

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Top Stat Card Style -->
        <Style x:Key="TopStatCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF17181A" />
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentLimeBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF17181A" />
            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentLimeBrush}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#33E85959"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
        </Style>

        <!-- Sidebar Navigation Items using DataTriggers for active state -->
        <Style x:Key="SidebarNavBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- TITLE BAR BUTTONS -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemItem}" ItemsSource="{Binding Children}">
            <Border Padding="4,8" Cursor="Hand" Background="Transparent" ToolTip="{Binding Path}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" Background="#1AFFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextWhiteBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource SizeToString}}" Foreground="{StaticResource TextGrayBrush}" FontSize="13" VerticalAlignment="Center" />
                    
                    <Border Grid.Column="3" Style="{StaticResource SmallBadge}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{Binding Path=IsDirectory, Converter={StaticResource BoolToLightRedGreenConverter}}">
                         <TextBlock Text="{Binding TypeName}" Foreground="{Binding Path=IsDirectory, Converter={StaticResource BoolToDarkRedGreenConverter}}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    
                    <TextBlock Grid.Column="4" Text="{Binding Level, StringFormat='{}Уровень {0}'}" Foreground="{StaticResource TextGrayBrush}" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <!-- View Visibility Styles -->
        <Style x:Key="DashboardViewStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentViewIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TreemapViewStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListViewStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmartFilterViewStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentViewIndex}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Grid Grid.Row="0" Background="{StaticResource BgVeryDarkBrush}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppTitle}" Foreground="{StaticResource TextGrayBrush}" FontSize="12" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"/>
                <!-- Windows 11 style maximize icon -->
                <Button Content="☐" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- MAIN WINDOW CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Grid Grid.Column="0" Background="{StaticResource BgVeryDarkBrush}">
                <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,1,0"/>
                <StackPanel Margin="24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                        <Border Background="{StaticResource AccentLimeBrush}" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="D" FontWeight="Bold" FontSize="18" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding AppTitle}" Foreground="{StaticResource TextWhiteBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,32"/>
                    
                    <TextBlock Text="Обзор" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="4,0,0,12"/>
                    
                    <!-- Nav: Dashboard -->
                    <Border Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarNavBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetViewCommand}" CommandParameter="Dashboard"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0"/>
                            <TextBlock Text="Дашборд" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource AccentLimeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nav: Treemap -->
                    <Border Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarNavBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetViewCommand}" CommandParameter="Treemap"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗺️" Margin="0,0,12,0"/>
                            <TextBlock Text="Карта диска" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1">
                                                <Setter Property="Foreground" Value="{StaticResource AccentLimeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nav: File List -->
                    <Border Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarNavBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetViewCommand}" CommandParameter="List"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,12,0"/>
                            <TextBlock Text="Файловая структура" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2">
                                                <Setter Property="Foreground" Value="{StaticResource AccentLimeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Фильтры и Анализ" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="4,32,0,12"/>

                    <!-- Nav: Smart Filter -->
                    <Border Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarNavBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewIndex}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SetViewCommand}" CommandParameter="SmartFilter"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,12,0"/>
                            <TextBlock Text="Умный фильтр" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="3">
                                                <Setter Property="Foreground" Value="{StaticResource AccentLimeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="Выбранный диск:" Foreground="{StaticResource TextGrayBrush}" FontSize="13" Margin="4,0,0,8"/>
                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}" Margin="0,0,0,20">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#17181A" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33C0EE5A" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#22C0EE5A" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentLimeBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                        <TextBlock Text="Мин. размер (МБ): " Foreground="{StaticResource TextGrayBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="10240" Value="{Binding MinSizeMB}" Foreground="{StaticResource AccentLimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding MinSizeMB, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="4,6" FontSize="13" />
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                        <TextBlock Text="Глубина вложенности: " Foreground="{StaticResource TextGrayBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="1" Maximum="20" Value="{Binding MaxDepth}" Foreground="{StaticResource AccentLimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="4,6" FontSize="13" />
                    </Grid>
                    
                    <Button Content="Сканировать" Style="{StaticResource PrimaryButton}" Command="{Binding RescanCommand}" Margin="0,20,0,0" Visibility="{Binding IsScanning, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Content="🛑 Остановить" Style="{StaticResource DangerButton}" Command="{Binding CancelScanCommand}" Margin="0,20,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- ===== MAIN CONTENT ===== -->
            <ScrollViewer Grid.Column="1" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="32">
                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Главная" Foreground="{StaticResource TextGrayBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" / " Foreground="{StaticResource TextGrayBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Дашборд" Foreground="{StaticResource AccentLimeBrush}" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1"><Setter Property="Text" Value="Карта диска"/></DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2"><Setter Property="Text" Value="Файловая структура"/></DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentViewIndex}" Value="3"><Setter Property="Text" Value="Умный фильтр"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextGrayBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <ProgressBar Width="100" Height="6" Value="{Binding ScanProgress}" Maximum="100" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource AccentLimeBrush}" Background="#222"/>
                        </StackPanel>
                    </Grid>

                    <!-- DASHBOARD VIEW -->
                    <Grid Style="{StaticResource DashboardViewStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Statistics Row -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource TopStatCard}">
                                <StackPanel>
                                    <TextBlock Text="Всего места" Foreground="{StaticResource TextGrayBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding TotalSpaceStr}" Foreground="{StaticResource TextWhiteBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SmallBadge}" Background="#1AFFFFFF">
                                            <TextBlock Text="100%" Foreground="{StaticResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text=" Объем диска" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Style="{StaticResource TopStatCard}">
                                <StackPanel>
                                    <TextBlock Text="Занято" Foreground="{StaticResource TextGrayBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding UsedSpaceStr}" Foreground="{StaticResource TextWhiteBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SmallBadge}" Background="#33E85959">
                                            <TextBlock Text="{Binding UsedSpacePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentRedBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text=" Недоступно" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource TopStatCard}">
                                <StackPanel>
                                    <TextBlock Text="Свободно" Foreground="{StaticResource TextGrayBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding FreeSpaceStr}" Foreground="{StaticResource TextWhiteBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SmallBadge}" Background="#33C0EE5A">
                                            <TextBlock Text="{Binding FreeSpacePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentLimeBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text=" Доступно" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource TopStatCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Просканировано" Foreground="{StaticResource TextGrayBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding ScannedCountStr}" Foreground="{StaticResource TextWhiteBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SmallBadge}" Background="#1AFFFFFF">
                                            <TextBlock Text="Обработано" Foreground="{StaticResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text=" В памяти" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left: Mini Treemap -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="450"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Border Background="#1AFFFFFF" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"/>
                                        <TextBlock Text="Карта диска (Предпросмотр)" Foreground="{StaticResource TextWhiteBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <ItemsControl Grid.Row="1" x:Name="TreemapCanvasMini" ItemsSource="{Binding TreemapItems}" SizeChanged="TreemapCanvas_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <!-- Reused template from full Treemap view -->
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="4" Cursor="Hand" SnapsToDevicePixels="True" ClipToBounds="True">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenInExplorerTreemapCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="{Binding FontSize}" FontWeight="SemiBold" Margin="4,2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.9">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowLabel}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            
                            <!-- Right: Largest Elements -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Крупнейшие элементы" Foreground="{StaticResource TextWhiteBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                    
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopLargestItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="32" Height="32" Background="#1AFFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextWhiteBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextGrayBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource AccentRedBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TREEMAP VIEW (Full) -->
                    <Grid Style="{StaticResource TreemapViewStyle}">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="700"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Background="#1AFFFFFF" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"/>
                                    <TextBlock Text="Карта диска (Полная)" Foreground="{StaticResource TextWhiteBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <ItemsControl Grid.Row="1" x:Name="TreemapCanvasFull" ItemsSource="{Binding TreemapItems}" SizeChanged="TreemapCanvas_SizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent" ClipToBounds="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="4" Cursor="Hand" SnapsToDevicePixels="True" ClipToBounds="True">
                                                <Border.ToolTip>
                                                    <StackPanel MaxWidth="400">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White" />
                                                        <TextBlock Text="{Binding TypeName}" Foreground="#8C8D8E" FontSize="12" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding FormattedSize}" Foreground="{StaticResource AccentLimeBrush}" FontSize="13" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Path}" Foreground="#8C8D8E" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border.ToolTip>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenInExplorerTreemapCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="{Binding FontSize}" FontWeight="SemiBold" Margin="4,2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.9">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowLabel}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LIST / ANALYTICS VIEW -->
                    <StackPanel Style="{StaticResource ListViewStyle}">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="700"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Файловая структура (Иерархия)" Foreground="{StaticResource TextWhiteBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Имя элемента" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Размер" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="Тип" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="Уровень вложенности" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,28"/>
                                
                                <TreeView Grid.Row="2" ItemsSource="{Binding TreeViewItems}" Background="Transparent" Foreground="{StaticResource TextWhiteBrush}" BorderThickness="0" Padding="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <TreeView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1AFFFFFF" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0DFFFFFF" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="IsExpanded" Value="False" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- SMART FILTER VIEW -->
                    <Grid Style="{StaticResource SmartFilterViewStyle}">
                        <views:SmartFilterView DataContext="{Binding SmartFilter}"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
